{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "10k-takes-sales-command-center",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-05",
	"workers_dev": true,
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	"vars": {
		"PUBLIC_READ_ORIGIN": "https://10000takes.github.io",
		"MCP_ENVIRONMENT": "production",
		"MCP_SERVICE_NAME": "10K Hub CRM — Production",
		"MCP_SERVER_URL": "https://10k-takes-sales-command-center.10ktakes.workers.dev/mcp",
		"MCP_OAUTH_ISSUER": "https://10k-takes-sales-command-center.10ktakes.workers.dev",
		"MCP_CRM_API_BASE_URL": "https://10k-takes-sales-command-center.10ktakes.workers.dev"
	},
	"ai": {
		"binding": "AI"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "10k-takes-sales-command-center",
			"database_id": "3823f4a6-0ba4-449b-81a5-5fb6a9225b3d",
			"preview_database_id": "10k-takes-sales-command-center-local"
		},
		{
			"binding": "_10k_takes_sales_command_center",
			"database_name": "10k-takes-sales-command-center",
			"database_id": "3823f4a6-0ba4-449b-81a5-5fb6a9225b3d",
			"remote": true
		}
	],
	"env": {
		"staging": {
			"name": "10k-takes-sales-command-center-staging",
			"compatibility_flags": [
				"global_fetch_strictly_public"
			],
			"workers_dev": true,
			"triggers": {
				"crons": [
					"*/15 * * * *"
				]
			},
			"vars": {
				"PUBLIC_READ_ORIGIN": "https://10000takes.github.io",
				"MCP_ENVIRONMENT": "staging",
				"MCP_SERVICE_NAME": "10K Hub Partnerships CRM",
				"MCP_SERVER_URL": "https://10k-takes-sales-command-center-staging.10ktakes.workers.dev/mcp",
				"MCP_OAUTH_ISSUER": "https://10k-takes-sales-command-center-staging.10ktakes.workers.dev",
				"MCP_CRM_API_BASE_URL": "https://10k-takes-sales-command-center-staging.10ktakes.workers.dev"
			},
			"kv_namespaces": [
				{
					"binding": "OAUTH_KV",
					"id": "22445adea8f2460fa8a14a04fee6f9b5"
				}
			],
			"ai": {
				"binding": "AI"
			},
			"version_metadata": {
				"binding": "CF_VERSION_METADATA"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "10k-takes-sales-command-center-staging",
					"database_id": "0b960090-30e9-43ed-bd15-1ad7dfe05f81"
				}
			]
		}
	},
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV",
			"id": "0aba0c53dcc443b7975c9086b09fe78a",
			"remote": true
		}
	]
}
