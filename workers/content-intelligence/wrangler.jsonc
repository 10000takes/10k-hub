{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "10k-takes-content-intelligence",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-04",
  "workers_dev": true,
  "vars": {
    "PUBLIC_READ_ORIGIN": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "10k-takes-content-intelligence",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "preview_database_id": "10k-takes-content-intelligence-local"
    }
  ]
}
